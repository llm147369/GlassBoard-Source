<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>GlassBoard</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="_coretest\**\*.cs" />
    <EmbeddedResource Remove="_coretest\**" />
    <None Remove="_coretest\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <!-- Windows 10/11 WinRT 元数据：仅编译期引用，运行时由操作系统提供（通知监听） -->
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.19041.1" PrivateAssets="All" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="GlassBoard.MediaBridge.ps1" LogicalName="GlassBoard.MediaBridge.ps1" />
    <EmbeddedResource Include="GlassBoard.NativeMediaBridge.ps1" LogicalName="GlassBoard.NativeMediaBridge.ps1" />
    <EmbeddedResource Include="GlassBoard\ControlCenter.ps1" LogicalName="GlassBoard.ControlCenter.ps1" />
    <EmbeddedResource Include="GlassBoard\Assets\launchpad.png" LogicalName="GlassBoard.Assets.launchpad.png" />
    <EmbeddedResource Include="GlassBoard\Assets\settings.svg" LogicalName="GlassBoard.Assets.settings.svg" />
    <EmbeddedResource Include="GlassBoard\Assets\running.png" LogicalName="GlassBoard.Assets.running.png" />
    <EmbeddedResource Include="GlassBoard\Assets\wechat.jpg" LogicalName="GlassBoard.Assets.wechat.jpg" />
    <EmbeddedResource Include="GlassBoard\Assets\alipay.jpg" LogicalName="GlassBoard.Assets.alipay.jpg" />
  </ItemGroup>
  <ItemGroup>
    <!-- 原生媒体兼容桥依赖：随输出目录一起发布，否则 NativeMediaBridge 无法加载 -->
    <None Include="..\lib\NPSMLib.dll">
      <Link>lib\NPSMLib.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- WebView2 原生加载器：固定 x64 版（AnyCPU 下 NuGet 默认选 x86 资产会 BadImageFormat） -->
    <None Include="..\lib\WebView2Loader.dll">
      <Link>WebView2Loader.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Interop.UIAutomationClient">
      <HintPath>lib\Interop.UIAutomationClient.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Core" />
    <Reference Include="System.Management" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <!-- WebView2 包在 AnyCPU/net48 下会选 x86 原生加载器（运行时 BadImageFormat）；构建最后强制覆盖为 x64 -->
  <Target Name="ForceX64WebView2Loader" AfterTargets="Build">
    <Copy SourceFiles="..\lib\WebView2Loader.dll" DestinationFiles="$(OutputPath)WebView2Loader.dll" SkipUnchangedFiles="true" />
  </Target>
</Project>
